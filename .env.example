# Copier en .env (jamais commité). Les variables sont lues depuis l'environnement.
NODE_ENV=development
PORT=3000

# ---- Base de données ----
# Développement : SQLite (aucune installation). Production : MariaDB 10.6+ (DB_DRIVER=mariadb, npm install mysql2).
DB_DRIVER=sqlite
DB_FILE=./data/dev.sqlite
# MariaDB (utilisé si DB_DRIVER=mariadb) — le schéma est créé automatiquement au premier démarrage
MARIADB_HOST=127.0.0.1
MARIADB_PORT=3306
MARIADB_USER=gp
MARIADB_PASSWORD=
MARIADB_DATABASE=Gestion_pharmacie
MARIADB_SSL=false
MARIADB_ROOT_PASSWORD=

# ---- Sécurité ----
# OBLIGATOIRE en production : chaîne aléatoire >= 32 caractères (openssl rand -hex 48)
JWT_SECRET=dev-only-change-me-dev-only-change-me
# Jeton exigé pour créer le premier compte administrateur en production (openssl rand -hex 16)
SETUP_TOKEN=
# Clé des sauvegardes chiffrées (openssl rand -hex 32)
BACKUP_KEY=
ACCESS_TTL_MIN=15
REFRESH_TTL_DAYS=14
# true en production : MFA TOTP obligatoire pour les rôles privilégiés
MFA_REQUIRED_FOR_PRIVILEGED=false
# Origines autorisées (CORS) pour l'app mobile / un front séparé, séparées par des virgules
CORS_ORIGINS=
# UPLOAD_DIR : inutile — les fichiers sont stockés dans la base (ancien dossier lu seulement en repli)
UPLOAD_DIR=./data/uploads

# NB : l'application lit SMTP_* (et non MAIL_*). Gmail : SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, mot de passe d'application.
# ---- Notifications e-mail / SMS (facultatif) ----
# Adresse publique de l'application (liens « mot de passe oublié »)
APP_URL=https://pharmacie.jtconsultingcg.com
# E-mail SMTP : 587 = STARTTLS, 465 = TLS implicite (SMTP_SECURE=true)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Pharmacie <noreply@exemple.com>
# SMS : le serveur envoie POST JSON { to, text } à l'adresse de votre prestataire
SMS_WEBHOOK_URL=
SMS_WEBHOOK_TOKEN=

# ---- Antivirus des ordonnances (facultatif, ClamAV clamd) ----
CLAMD_HOST=
CLAMD_PORT=3310
# true : un fichier non analysable (clamd injoignable) est retiré
CLAMD_REQUIRED=false

# ---- Proxy inverse ----
# À mettre à "true" UNIQUEMENT derrière un proxy de confiance (nginx, Caddy…) qui écrase X-Forwarded-For
# (nginx : proxy_set_header X-Forwarded-For $remote_addr;). Sinon le journal d'audit et les limites par IP utilisent l'adresse du socket.
TRUSTED_PROXY=false

# ---- Paiements en ligne ----
# URL publique de l'API/site (retours de paiement et webhooks). Obligatoire pour Stripe / Konnect.
API_PUBLIC_URL=https://pharmacie.jtconsultingcg.com
# Autoriser le prestataire "bac à sable" (tests uniquement, JAMAIS en production)
PAYMENT_SANDBOX=false

# ---- Notifications push mobiles (Expo) ----
PUSH_ENABLED=false
# EXPO_ACCESS_TOKEN=

# ---- Cartes (livraison) ----
# Clé Google Maps (Maps JavaScript, Places, Directions, Geocoding). À restreindre à votre domaine dans la console Google Cloud.
GOOGLE_MAPS_API_KEY=
# Sans clé Google : OpenStreetMap (gratuit, sans carte bancaire). Pour un fort trafic, pointez vers vos propres serveurs :
# OSM_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
# NOMINATIM_URL=https://nominatim.openstreetmap.org
# OSRM_URL=https://router.project-osrm.org
# Votre e-mail de contact, exigé par les conditions d'usage de Nominatim
MAPS_CONTACT_EMAIL=
# ---- SMS (facultatif) ----
# La passerelle SMS se règle aussi depuis l'application (Finance & API → SMS, super-administrateur) ; ces variables servent de valeurs par défaut.
SMS_URL=
SMS_API_KEY=
SMS_AUTH_HEADER=Authorization: Bearer {{key}}
SMS_BODY={"to":"{{to}}","from":"{{sender}}","text":"{{text}}"}
SMS_SENDER=Pharmacie
