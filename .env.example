# ============================================================
#  .env — à placer à la RACINE du projet (à côté de package.json). Ne jamais le commiter ni l'envoyer.
#  Démarrage local sur VOTRE base MariaDB :  npm run check:mariadb   puis   npm start
#  (npm start lit ce fichier automatiquement ; sur Render, saisissez ces mêmes variables dans le tableau de bord)
# ============================================================
APP_NAME="PharmaConnect"

NODE_ENV=production


# ---- Base de données : MariaDB (hPanel Hostinger → Bases de données) ----
DB_DRIVER=mariadb
# Hôte à utiliser depuis l'extérieur : celui indiqué par Hostinger pour l'accès distant (pas "localhost", sauf si l'application tourne chez Hostinger)
MARIADB_HOST=srv1904.hstgr.io
MARIADB_PORT=3306
MARIADB_USER=u353337331_pharmacie
MARIADB_PASSWORD=Chrisamour12@
MARIADB_DATABASE=u353337331_g_pharmacie
MARIADB_SSL=true
# true = refuser de démarrer si MariaDB interdit les triggers (protection du journal d'audit) ; false = avertissement seulement
MARIADB_REQUIRE_TRIGGERS=false
MARIADB_TIMEOUT_MS=300000 


# ---- Sécurité (valeurs générées pour vous : gardez-les, ne les partagez pas) ----
JWT_SECRET=a085ac697e4309672b576c84713dea80f27b90e1ce2452cba21afc708c0ac335b0d01908834bf9ce082395c8ec37a8c1
